<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.douban.frodo" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.taobao.idlefish" />
        <package android:name="com.tencent.mm" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.xingin.xhs" />
    </queries>
    <application android:label="@string/app_name" android:theme="@style/AppTheme"
        android:icon="@drawable/ic_launcher" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".WidgetSearchActivity" android:exported="false" android:theme="@style/WidgetSearchTheme"
            android:taskAffinity="org.nofeed.android.widget" android:excludeFromRecents="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize|stateAlwaysVisible" />
        <receiver android:name=".SearchWidget" android:label="@string/widget_compact_name" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/search_widget" />
        </receiver>
        <service android:name=".WidgetAppsService" android:exported="false" android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service android:name=".WechatSearchService" android:label="@string/wechat_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/wechat_accessibility" />
        </service>
    </application>
</manifest>
