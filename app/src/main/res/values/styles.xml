<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/noto_serif_sc_regular</item>
        <item name="android:colorAccent">#474E47</item>
        <item name="android:alertDialogTheme">@style/SettingsDialogTheme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#282F29</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="SettingsDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#474E47</item>
    </style>
    <style name="WidgetSearchTheme" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
        <item name="android:colorAccent">#474E47</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
