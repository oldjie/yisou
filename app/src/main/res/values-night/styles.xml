<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/noto_serif_sc_regular</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:alertDialogTheme">@style/SettingsDialogTheme</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/ui_paper</item>
        <item name="android:navigationBarColor">@color/ui_paper</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/ui_paper</item>
    </style>
    <style name="SettingsDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:colorBackground">@color/ui_surface</item>
    </style>
    <style name="WidgetSearchTheme" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimAmount">0.18</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:alertDialogTheme">@style/SettingsDialogTheme</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
